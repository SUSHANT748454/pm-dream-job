# Copy to .env.local and fill in. All optional — with none of these set, the app
# runs exactly as before (localStorage only, no sign-in).

# Supabase — from Project Settings → API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only for scripts (scripts/ingest, scripts/alerts) — NEVER expose these.
# Set as GitHub Actions secrets, not here in git.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RESEND_API_KEY=your-resend-api-key           (scripts/alerts only)
# ALERTS_FROM_EMAIL=alerts@yourdomain.com      (scripts/alerts only)

# Optional: pin the canonical site URL (else auto-detected on Vercel).
# NEXT_PUBLIC_SITE_URL=https://pm-dream-job.vercel.app
