# Copy to .env.local and fill in. All optional — with none of these set, the app
# runs exactly as before (localStorage only, no sign-in).

# Supabase — from Project Settings → API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only for scripts (scripts/ingest, scripts/alerts) — NEVER expose these.
# Set as GitHub Actions secrets, not here in git.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RESEND_API_KEY=your-resend-api-key           (scripts/alerts only)
# ALERTS_FROM_EMAIL=alerts@yourdomain.com      (scripts/alerts only)

# Server-only, for src/app/api/interview (the AI mock interview route).
# NEVER expose these with a NEXT_PUBLIC_ prefix. Set as Vercel env vars
# (Settings → Environment Variables) — this route runs on Vercel, not
# GitHub Actions, so it needs its own copy of the service-role key there.
# ANTHROPIC_API_KEY=sk-ant-...                       (console.anthropic.com)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key    (Vercel copy)

# Optional: pin the canonical site URL (else auto-detected on Vercel).
# NEXT_PUBLIC_SITE_URL=https://pm-dream-job.vercel.app
